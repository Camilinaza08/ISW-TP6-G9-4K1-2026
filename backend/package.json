{
  "name": "backend",
  "version": "1.0.0",
  "description": "TP6",
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "start": "node index.js",
    "dev": "nodemon index.js"
  },
  "jest": {
    "testEnvironment": "node",
    "coveragePathIgnorePatterns": [
      "/node_modules/"
    ],
    "moduleFileExtensions": [
      "js",
      "json"
    ],
    "testMatch": [
      "**/__tests__/**/*.js",
      "**/?(*.)+(spec|test).js"
    ],
    "verbose": true
  },
  "dependencies": {
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "jest": "^30.5.2",
    "mercadopago": "^3.6.1",
    "nodemon": "^3.1.14"
  },
  "devDependencies": {
    "supertest": "^7.3.1"
  }
}
